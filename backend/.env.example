NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
CLERK_SECRET_KEY=sk_test_replace_me
DEMO_AUTH_ENABLED=false
DEMO_AUTH_SECRET=replace_with_at_least_32_random_characters
# Closed testing only: allow demo sign-in on a production server. Turn off before launch.
DEMO_AUTH_ALLOW_IN_PRODUCTION=false

DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CLERK_SECRET_KEY=sk_test_replace_me

# Push notifications: path to the Firebase service account key (JSON).
# Keep the file outside the repository. Leave unset to disable pushes.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-admin.json

# LiveKit Cloud credentials for authenticated Vibe audio rooms.
# Keep the API secret on the backend; never copy it into the Flutter app.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=replace_me
# LIVEKIT_API_SECRET=replace_me
